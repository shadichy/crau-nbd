<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-crau-payload">
    <comment>ChromeOS / Android OTA Payload</comment>
    <glob pattern="payload.bin"/>
    <glob pattern="*.bin"/>
    <magic priority="70">
      <match type="string" offset="0" value="CrAU"/>
    </magic>
    <sub-class-of type="application/octet-stream"/>
  </mime-type>
</mime-info>
